.hero{padding:42rpx 20rpx 34rpx;text-align:center}.eyebrow,.title,.subtitle{display:block}.eyebrow{color:#bd643c;font-size:24rpx;letter-spacing:4rpx}.title{margin-top:18rpx;color:#b85431;font-size:52rpx;font-weight:800}.subtitle{margin-top:16rpx;color:#876c5e;font-size:28rpx}.grade-grid{display:grid;grid-template-columns:1fr 1fr;gap:24rpx}.grade-card{height:190rpx;padding:28rpx;border:4rpx solid transparent;border-radius:28rpx;background:#fff;text-align:left;box-shadow:0 12rpx 35rpx rgba(103,62,40,.08)}.grade-card.active{border-color:var(--grade-color);transform:translateY(-4rpx)}.grade-name,.grade-desc{display:block}.grade-name{color:var(--grade-color);font-size:42rpx;font-weight:800}.grade-desc{margin-top:14rpx;color:#80695e;font-size:23rpx}.share-tip{margin-top:40rpx;border-radius:999rpx;background:#ff6b32;color:#fff;font-size:30rpx;font-weight:700}
