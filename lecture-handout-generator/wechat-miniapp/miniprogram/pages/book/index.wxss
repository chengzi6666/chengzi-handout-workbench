.state{padding:180rpx 40rpx;text-align:center;color:#8b6d5f;font-size:30rpx}.state.error{color:#c84f36}.reader{min-height:100vh;box-sizing:border-box;padding:24rpx;background:#f5ede4}.reader-head{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:20rpx}.book-title,.book-desc{display:block}.book-title{color:#b85431;font-size:32rpx;font-weight:800}.book-desc{margin-top:6rpx;color:#8d7468;font-size:21rpx}.share{width:120rpx;margin:0;border-radius:999rpx;background:#c56b43;color:#fff;font-size:24rpx}.spread{display:flex;justify-content:center;gap:16rpx}.page{position:relative;width:100%;min-height:1050rpx;box-sizing:border-box;overflow:hidden;padding:58rpx 52rpx 86rpx;border-radius:16rpx;background-color:#fffaf4;background-position:center;background-size:cover;box-shadow:0 10rpx 35rpx rgba(70,42,27,.14)}.landscape .page{width:50%;min-height:620rpx}.page-title{display:block;margin-bottom:34rpx;color:#c35b34;font-size:40rpx;font-weight:800}.block{margin-bottom:22rpx;font-size:29rpx;line-height:1.75}.teacher{position:absolute;right:24rpx;bottom:42rpx;width:220rpx;height:300rpx}.controls{display:flex;align-items:center;justify-content:space-between;margin-top:24rpx}.controls button{width:190rpx;margin:0;border-radius:999rpx;background:#fff;color:#a85432;font-size:26rpx}.controls text{color:#896f62;font-size:24rpx}
