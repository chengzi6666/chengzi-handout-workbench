{
  "name": "lecture-handout-generator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --env-file=.env src/worker/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "teachers:import-assets": "tsx --env-file=.env scripts/import-teacher-assets.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@prisma/client": "^6.5.0",
    "docx": "^9.7.1",
    "html2canvas": "^1.4.1",
    "jose": "^6.0.8",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "next": "^15.2.4",
    "pinyin-pro": "^3.29.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
